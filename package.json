{
  "name": "@amatsuka/chat-adapter-qq",
  "version": "0.1.13",
  "description": "QQ adapter for chat",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader native",
    "build:production": "NODE_ENV=production tsdown --config-loader native --sourcemap false",
    "pretest": "pnpm run build",
    "test": "node --test test/*.test.*",
    "test:coverage": "node --test --test-coverage test/*.test.*",
    "test:watch": "node --test --watch test/*.test.*",
    "test:bot": "pnpm run build && node --env-file=.env.local --experimental-strip-types test/server.mjs",
    "test:bot:ws": "pnpm run build && QQ_MODE=ws node --env-file=.env.ws.local --experimental-strip-types test/server.mjs",
    "test:c2c-proactive": "pnpm run build && node --env-file=.env.local --experimental-strip-types test/c2c-proactive.ts",
    "typecheck": "tsc && tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "chat": "^4.34.0"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "^4.34.0",
    "@types/node": "^25.6.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wsyzxjn/chat-adapter-qq.git"
  },
  "homepage": "https://github.com/wsyzxjn/chat-adapter-qq#readme",
  "bugs": {
    "url": "https://github.com/wsyzxjn/chat-adapter-qq/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "chat",
    "chat-sdk",
    "chat-adapter",
    "qq",
    "bot",
    "adapter"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
